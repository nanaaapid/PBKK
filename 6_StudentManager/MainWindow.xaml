<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System"
        Width="1200"
        Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="🎓 STUDENT MANAGEMENT SYSTEM"
                           Foreground="White"
                           FontSize="27"
                           FontWeight="Bold"/>
                <TextBlock Text="Manage student data easily"
                           Foreground="White"
                           FontSize="14"
                           Opacity="0.85"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- FORM -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top">

                <StackPanel>
                    <TextBlock Text="✏ INPUT MAHASISWA"
                               Foreground="#1565C0"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="NIM"/>
                    <TextBox Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Nama"/>
                    <TextBox Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Jurusan"/>
                    <ComboBox SelectedValue="{Binding SelectedStudent.Jurusan}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="Informatika"/>
                        <ComboBoxItem Content="Sistem Informasi"/>
                    </ComboBox>

                    <TextBlock Text="Gender"/>
                    <ComboBox SelectedValue="{Binding SelectedStudent.Gender}" 
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="Laki-laki"/>
                        <ComboBoxItem Content="Perempuan"/>
                    </ComboBox>

                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="💾 Simpan"
                                Command="{Binding SaveCommand}"
                                Background="#1976D2"
                                Foreground="White"/>

                        <Button Content="🗑 Hapus"
                                Command="{Binding DeleteCommand}"
                                Background="#E53935"
                                Foreground="White"/>

                        <Button Content="↻ Reset"
                                Command="{Binding ResetCommand}"
                                Background="#E0E0E0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- INFORMATION + DATA -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="10,0,0,0">

                <StackPanel>
                    <TextBlock Text="📊 INFORMASI"
                            Foreground="#1565C0"
                            FontSize="20"
                            FontWeight="Bold"
                            Margin="0,0,0,15"/>

                    <!-- STATISTICS -->
                    <UniformGrid Columns="2"
                                Rows="2"
                                Margin="0,0,0,15">

                        <Border Background="#E3F2FD"
                                CornerRadius="10"
                                Margin="5"
                                Padding="15">

                            <StackPanel>
                                <TextBlock Text="Total Mahasiswa"/>
                                <TextBlock Text="{Binding TotalStudents}"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Foreground="#1565C0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#E8F5E9"
                                CornerRadius="10"
                                Margin="5"
                                Padding="15">

                            <StackPanel>
                                <TextBlock Text="Informatika"/>
                                <TextBlock Text="{Binding TotalInformatika}"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Foreground="#2E7D32"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF3E0"
                                CornerRadius="10"
                                Margin="5"
                                Padding="15">

                            <StackPanel>
                                <TextBlock Text="Sistem Informasi"/>
                                <TextBlock Text="{Binding TotalSistemInformasi}"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Foreground="#EF6C00"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FCE4EC"
                                CornerRadius="10"
                                Margin="5"
                                Padding="15">

                            <StackPanel>
                                <TextBlock Text="Laki-laki / Perempuan"/>
                                <TextBlock Text="{Binding TotalLakiLaki, StringFormat=L: {0}}"
                                        FontWeight="Bold"
                                        FontSize="18"/>
                                <TextBlock Text="{Binding TotalPerempuan, StringFormat=P: {0}}"
                                        FontWeight="Bold"
                                        FontSize="18"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- DATA MAHASISWA -->
                    <Border Background="#F8FAFD"
                            BorderBrush="#E0E6EF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">

                        <StackPanel>
                            <TextBlock Text="📋 DATA MAHASISWA"
                                    Foreground="#1565C0"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Margin="5,0,5,8"/>

                            <DataGrid ItemsSource="{Binding Students}"
                                    SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    GridLinesVisibility="Horizontal"
                                    FontSize="13"
                                    Height="120">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NIM"
                                                        Binding="{Binding NIM}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Nama"
                                                        Binding="{Binding Nama}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Jurusan"
                                                        Binding="{Binding Jurusan}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Gender"
                                                        Binding="{Binding Gender}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Email"
                                                        Binding="{Binding Email}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SEARCH -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0"
                         ToolTip="Cari berdasarkan NIM, Nama, atau Jurusan"/>

                <Button Grid.Column="1"
                        Content="🔍 Cari"
                        Command="{Binding SearchCommand}"
                        Background="#1976D2"
                        Foreground="White"/>

                <Button Grid.Column="2"
                        Content="↻"
                        Command="{Binding ResetCommand}"/>
            </Grid>
        </Border>

    </Grid>
</Window>